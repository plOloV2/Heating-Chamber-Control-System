#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

# Check if exactly one argument is passed
if [ "$#" -ne 1 ]; then
    echo "Usage: $(basename "$0") <firmware.hex | firmware.elf | firmware.bin>"
    exit 1
fi

FIRMWARE="$1"

# Check if the file actually exists
if [ ! -f "$FIRMWARE" ]; then
    echo "Error: File '$FIRMWARE' not found!"
    exit 1
fi

# Detect the appropriate GDB executable
if command -v arm-none-eabi-gdb &> /dev/null; then
    GDB="arm-none-eabi-gdb"
elif command -v gdb-multiarch &> /dev/null; then
    GDB="gdb-multiarch"
else
    echo "Error: Neither 'arm-none-eabi-gdb' nor 'gdb-multiarch' found in your PATH."
    exit 1
fi

# Point directly to the symlink created by your udev rules
BMP_PORT="/dev/ttyBmpGdb"

if [ ! -e "$BMP_PORT" ]; then
    echo "Error: Black Magic Probe GDB server not found at $BMP_PORT."
    exit 1
fi

echo "--- Target MCU Scan ---"
# Run a dry-run scan to detect the connected MCU and capture the output
SCAN_OUT=$($GDB -nx --batch -ex "target extended-remote $BMP_PORT" -ex "monitor swdp_scan" 2>&1)

# Extract the lines after "Available Targets:" to show the user
TARGET_LINE=$(echo "$SCAN_OUT" | awk '/Available Targets:/{flag=1; next} flag')

if [[ -z "$TARGET_LINE" || "$TARGET_LINE" == *"scan failed"* ]]; then
    echo "Error: Could not detect any connected MCU. Check your SWD wiring, target power, and ensure it is not in a deep sleep state."
    exit 1
else
    echo "Connected MCU(s) detected by BMP:"
    echo "$TARGET_LINE"
fi
echo "-----------------------"

# Handle file types and prompt for .bin address
if [[ "$FIRMWARE" == *.bin ]]; then
    # Prompt the user for the start address, default to 0x08000000
    read -p "Enter start address for .bin file [default: 0x08000000]: " START_ADDR
    # If the user just presses Enter, use the default
    START_ADDR=${START_ADDR:-0x08000000}

    LOAD_CMD="restore $FIRMWARE binary $START_ADDR"
else
    LOAD_CMD="load $FIRMWARE"
fi

echo ""
echo "--- Flashing Configuration ---"
echo "Firmware : $FIRMWARE"
echo "Command  : $LOAD_CMD"
echo "GDB Tool : $GDB"
echo "BMP Port : $BMP_PORT"
echo "------------------------------"

# Run GDB in batch mode to automate the flashing process
$GDB -nx --batch \
     -ex "target extended-remote $BMP_PORT" \
     -ex "monitor swdp_scan" \
     -ex "attach 1" \
     -ex "$LOAD_CMD" \
     -ex "kill"

echo ""
echo "Flashing complete! Target reset and detached."
