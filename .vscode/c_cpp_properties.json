{
    "version": 4,
    "configurations": [
        {
            "name": "Linux-ATfE",
            "includePath": [
                "${workspaceFolder}/app/inc",
                "${workspaceFolder}/CMSIS/Core/Include",
                "${workspaceFolder}/CMSIS/Device/Include"
            ],
            "defines": [],
            "compilerPath": "/usr/local/bin/arm-clang",
            "cStandard": "c23",
            "intelliSenseMode": "linux-clang-arm",
            "browse": {
                "path": [
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            },
            "compileCommands": ["${workspaceFolder}/build/Debug/compile_commands.json", "${workspaceFolder}/build/Release/compile_commands.json"],
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ]
}
